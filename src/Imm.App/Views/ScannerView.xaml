<UserControl x:Class="Imm.App.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Imm.Core.Localization;assembly=Imm.Core"
             Background="Transparent">

  <UserControl.Resources>
    <!-- one fact chip: label above, value below -->
    <Style x:Key="FactChipStyle" TargetType="Border">
      <Setter Property="Background" Value="#08FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource ImmLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <DataTemplate x:Key="PackDiagnosticsTemplate">
      <Border Background="{StaticResource ImmSurface2Brush}"
              BorderBrush="{StaticResource ImmLineBrush}" BorderThickness="1"
              CornerRadius="12" Padding="14" Margin="0,0,0,10">
        <StackPanel>
          <!-- header: name · engine chip · state -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ImmTextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Border Style="{StaticResource ImmChipStyle}" Margin="9,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                             Fill="{StaticResource ImmAccentCyanBrush}" />
                    <TextBlock Text="{Binding Summary}" FontSize="10.5" Margin="5,0,0,0"
                               Foreground="{StaticResource ImmTextSecondaryBrush}" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding RootPath}" FontSize="10.5" Margin="0,4,0,0"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource ImmTextTertiaryBrush}" />
            </StackPanel>

            <!-- state: amber badge when something is off, quiet green line when clean -->
            <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="6" Padding="7,3"
                    Background="#1FF0A33C" BorderBrush="#4DF0A33C" BorderThickness="1"
                    Visibility="{Binding IsProblem, Converter={StaticResource BoolToVisibleConverter}}">
              <TextBlock Text="{Binding ProblemBadge}" FontSize="10.5"
                         Foreground="{StaticResource ImmWarnBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Visibility="{Binding IsClean, Converter={StaticResource BoolToVisibleConverter}}">
              <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                       Fill="{StaticResource ImmSuccessBrush}" />
              <TextBlock Text="{Binding [Common_Ok], Source={x:Static loc:Loc.Instance}}" FontSize="10.5" Margin="6,0,0,0"
                         Foreground="{StaticResource ImmTextTertiaryBrush}" />
            </StackPanel>
          </Grid>

          <!-- facts as chips -->
          <WrapPanel Margin="0,12,0,0">
            <Border Style="{StaticResource FactChipStyle}">
              <StackPanel>
                <TextBlock Text="{Binding [Scan_ChipGame], Source={x:Static loc:Loc.Instance}}" FontSize="9.5" Foreground="{StaticResource ImmTextTertiaryBrush}" />
                <TextBlock Text="{Binding GameText}" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource FactChipStyle}">
              <StackPanel>
                <TextBlock Text="{Binding [Scan_ChipSource], Source={x:Static loc:Loc.Instance}}" FontSize="9.5" Foreground="{StaticResource ImmTextTertiaryBrush}" />
                <TextBlock Text="{Binding SourceText}" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource FactChipStyle}">
              <StackPanel>
                <TextBlock Text="{Binding [Scan_ChipProfile], Source={x:Static loc:Loc.Instance}}" FontSize="9.5" Foreground="{StaticResource ImmTextTertiaryBrush}" />
                <TextBlock Text="{Binding ProfileText}" FontSize="11.5" Margin="0,2,0,0" MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource FactChipStyle}">
              <StackPanel>
                <TextBlock Text="{Binding [Scan_ChipLoader], Source={x:Static loc:Loc.Instance}}" FontSize="9.5" Foreground="{StaticResource ImmTextTertiaryBrush}" />
                <TextBlock Text="{Binding LoaderText}" FontSize="11.5" Margin="0,2,0,0" MaxWidth="240"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </Border>
          </WrapPanel>

          <!-- warnings -->
          <StackPanel Margin="0,10,0,0"
                      Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibleConverter}}">
            <ItemsControl ItemsSource="{Binding Warnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <ui:SymbolIcon Symbol="Warning24" FontSize="12" VerticalAlignment="Top"
                                   Foreground="{StaticResource ImmWarnBrush}" />
                    <TextBlock Text="{Binding}" FontSize="11.5" Margin="7,0,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource ImmWarnBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- actions -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource ImmGhostButtonStyle}" Height="30"
                    Command="{Binding DataContext.RescanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Entry}"
                    ToolTip="{Binding [Scan_RescanTip], Source={x:Static loc:Loc.Instance}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="12"
                               Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="{Binding [Lib_Rescan], Source={x:Static loc:Loc.Instance}}" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ImmGhostButtonStyle}" Height="30" Margin="8,0,0,0"
                    Command="{Binding Entry.ChooseGameFolderCommand}"
                    ToolTip="{Binding [Scan_GameFolderTip], Source={x:Static loc:Loc.Instance}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12"
                               Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="{Binding [Scan_GameFolder], Source={x:Static loc:Loc.Instance}}" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ImmGhostButtonStyle}" Height="30" Margin="8,0,0,0"
                    Command="{Binding DataContext.OpenPackFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Entry}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Folder24" FontSize="12"
                               Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="{Binding [Det_PackFolder], Source={x:Static loc:Loc.Instance}}" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock Text="{Binding [Scan_Title], Source={x:Static loc:Loc.Instance}}" FontSize="26" FontWeight="SemiBold"
                 Foreground="{StaticResource ImmTextPrimaryBrush}" />
      <TextBlock Text="{Binding DiagnosticsStatus}" FontSize="13" Margin="10,0,0,4" VerticalAlignment="Bottom"
                 Foreground="{StaticResource ImmTextTertiaryBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,14,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button Style="{StaticResource ImmPrimaryButtonStyle}" Height="34"
                Command="{Binding RefreshDiagnosticsCommand}"
                ToolTip="{Binding [Scan_CheckTip], Source={x:Static loc:Loc.Instance}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ScanType24" FontSize="14" Foreground="White" />
            <TextBlock Text="{Binding [Scan_Check], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5"
                 Foreground="{StaticResource ImmTextTertiaryBrush}"
                 Text="{Binding [Scan_Hint], Source={x:Static loc:Loc.Instance}}" />
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Diagnostics}"
                    ItemTemplate="{StaticResource PackDiagnosticsTemplate}" />
    </ScrollViewer>

    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding HasNoDiagnostics, Converter={StaticResource BoolToVisibleConverter}}">
      <ui:SymbolIcon Symbol="ScanType24" FontSize="44" HorizontalAlignment="Center"
                     Foreground="{StaticResource ImmTextTertiaryBrush}" />
      <TextBlock Text="{Binding [Scan_EmptyTitle], Source={x:Static loc:Loc.Instance}}" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0"
                 HorizontalAlignment="Center" Foreground="{StaticResource ImmTextPrimaryBrush}" />
      <TextBlock Text="{Binding [Scan_EmptyHint], Source={x:Static loc:Loc.Instance}}"
                 FontSize="12.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                 Foreground="{StaticResource ImmTextTertiaryBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
