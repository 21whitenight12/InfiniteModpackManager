<Page x:Class="Imm.App.Views.LibraryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Imm.App.ViewModels"
      xmlns:loc="clr-namespace:Imm.Core.Localization;assembly=Imm.Core"
      xmlns:views="clr-namespace:Imm.App.Views"
      Background="Transparent">

  <Page.Resources>
    <!-- Pack context menu (opened by the '…' button; DataContext = the card's entry VM).
         Declared BEFORE the card templates: StaticResource inside a template cannot forward-reference. -->
    <ContextMenu x:Key="PackMenu"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="{Binding [Menu_Profile], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon PeopleTeam24}" ItemsSource="{Binding AvailableProfiles}">
        <MenuItem.ItemContainerStyle>
          <Style TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding DataContext.SetProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
          </Style>
        </MenuItem.ItemContainerStyle>
      </MenuItem>
      <MenuItem Header="{Binding [Menu_GameFolder], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon FolderOpen24}"
                Command="{Binding ChooseGameFolderCommand}"
                ToolTip="{Binding [Menu_GameFolderTip], Source={x:Static loc:Loc.Instance}}" />
      <Separator />
      <MenuItem Header="{Binding [Menu_Rename], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon Edit24}"
                Command="{Binding RenameCommand}" />
      <MenuItem Header="{Binding [Menu_Cover], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon ImageEdit24}"
                Command="{Binding ChangeCoverCommand}" />
      <Separator />
      <MenuItem Header="{Binding [Menu_OpenFolder], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon Folder24}"
                Command="{Binding OpenFolderCommand}" />
      <Separator />
      <MenuItem Header="{Binding [Menu_Backup], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon Archive24}"
                Command="{Binding CreateBackupCommand}"
                ToolTip="{Binding [Menu_BackupTip], Source={x:Static loc:Loc.Instance}}" />
      <MenuItem Header="{Binding [Menu_OpenBackups], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon Folder24}"
                Command="{Binding OpenBackupsFolderCommand}" />
      <Separator />
      <MenuItem Header="{Binding [Menu_Rescan], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                Command="{Binding RescanCommand}" />
      <Separator />
      <MenuItem Header="{Binding [Menu_Remove], Source={x:Static loc:Loc.Instance}}" Icon="{ui:SymbolIcon Delete24}"
                Command="{Binding DeleteCommand}" />
    </ContextMenu>

    <!-- ═══════════ GRID CARD: cover, engine chip, one meta line ═══════════ -->
    <DataTemplate x:Key="PackCardTemplate" DataType="{x:Type vm:LibraryEntryViewModel}">
      <Border Style="{StaticResource ImmCardStyle}">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick"
                        Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <StackPanel>
          <!-- Cover: 16:9 for a fixed 236px card -->
          <Grid Height="123">
            <Border CornerRadius="9" ClipToBounds="True" Background="#0A1119">
              <Image x:Name="CoverImage" Source="{Binding CoverImage}" Stretch="UniformToFill"
                     RenderTransformOrigin="0.5,0.5"
                     Visibility="{Binding CoverPath, Converter={StaticResource NullToCollapsedConverter}}">
                <Image.RenderTransform>
                  <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
              </Image>
            </Border>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding CoverPath, Converter={StaticResource NullToVisibleConverter}}">
              <ui:SymbolIcon Symbol="Library24" FontSize="26" HorizontalAlignment="Center"
                             Foreground="{StaticResource ImmTextTertiaryBrush}" />
              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,0"
                         HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"
                         Foreground="{StaticResource ImmTextTertiaryBrush}" />
            </StackPanel>

            <!-- hairline over the artwork -->
            <Border CornerRadius="9" BorderBrush="#1AFFFFFF" BorderThickness="1" IsHitTestVisible="False" />

            <!-- engine chip -->
            <Border Style="{StaticResource ImmCoverChipStyle}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                         Fill="{StaticResource ImmAccentCyanBrush}" />
                <TextBlock Text="{Binding EngineDisplayName}" FontSize="10.5" Margin="5,0,0,0"
                           Foreground="#DCE6F4" />
              </StackPanel>
            </Border>

            <!-- selection badge -->
            <Border Width="19" Height="19" CornerRadius="10"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                    Background="{StaticResource ImmAccentBrush}" BorderBrush="#CC060A10" BorderThickness="2"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibleConverter}}">
              <ui:SymbolIcon Symbol="Checkmark24" FontSize="9" Foreground="White" />
            </Border>

            <!-- context menu button: hover / selected only -->
            <Button x:Name="MoreButton" Style="{StaticResource ImmOverlayButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                    Click="OpenCardMenu" ContextMenu="{StaticResource PackMenu}"
                    Visibility="Collapsed" ToolTip="{Binding [Lib_PackActions], Source={x:Static loc:Loc.Instance}}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource ImmTextPrimaryBrush}" />
                <Ellipse Width="2.5" Height="2.5" Margin="2.5,0" Fill="{StaticResource ImmTextPrimaryBrush}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </Button>

            <!-- warning frame -->
            <Border CornerRadius="9" BorderBrush="{StaticResource ImmWarnBrush}" BorderThickness="1.5"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibleConverter}}" />
          </Grid>

          <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Margin="3,9,3,0"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource ImmTextPrimaryBrush}" />
          <TextBlock Text="{Binding MetaText}" FontSize="11.5" Margin="3,4,3,0"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource ImmTextTertiaryBrush}" />
        </StackPanel>
      </Border>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="MoreButton" Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX"
                                 To="1.035" Duration="0:0:0.5">
                  <DoubleAnimation.EasingFunction>
                    <QuinticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY"
                                 To="1.035" Duration="0:0:0.5">
                  <DoubleAnimation.EasingFunction>
                    <QuinticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX"
                                 To="1" Duration="0:0:0.32" />
                <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY"
                                 To="1" Duration="0:0:0.32" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="MoreButton" Property="Visibility" Value="Visible" />
          <!-- the selection badge owns the corner: shift the button so they never overlap -->
          <Setter TargetName="MoreButton" Property="Margin" Value="0,7,33,0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══════════ LIST ROW ═══════════ -->
    <DataTemplate x:Key="PackRowTemplate" DataType="{x:Type vm:LibraryEntryViewModel}">
      <Border x:Name="RowRoot" Background="{StaticResource ImmSurface2Brush}"
              BorderBrush="{StaticResource ImmLineBrush}" BorderThickness="1"
              CornerRadius="10" Padding="10,8" Margin="0,0,0,8" Cursor="Hand">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick"
                        Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Height="58" CornerRadius="7" ClipToBounds="True" Background="#0A1119">
            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding MetaText}" FontSize="11.5" Margin="0,3,0,0"
                       Foreground="{StaticResource ImmTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding PlaytimeText}" FontSize="12" VerticalAlignment="Center"
                     HorizontalAlignment="Right" MinWidth="80" TextAlignment="Right"
                     Foreground="{StaticResource ImmTextSecondaryBrush}" />
          <Button Grid.Column="5" Style="{StaticResource ImmOverlayButtonStyle}" VerticalAlignment="Center"
                  Click="OpenCardMenu" ContextMenu="{StaticResource PackMenu}"
                  ToolTip="{Binding [Lib_PackActions], Source={x:Static loc:Loc.Instance}}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource ImmTextPrimaryBrush}" />
              <Ellipse Width="2.5" Height="2.5" Margin="2.5,0" Fill="{StaticResource ImmTextPrimaryBrush}" />
              <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource ImmTextPrimaryBrush}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="RowRoot" Property="BorderBrush" Value="#BF3D7BFF" />
          <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource ImmSurface3Brush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Page.Resources>

  <!-- ══════════════ SHELL: sidebar 236 / content * / details 340 ══════════════ -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- ─────────── LEFT: brand, sections, status ─────────── -->
    <Border Grid.Column="0" BorderBrush="{StaticResource ImmLineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="12,16,12,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- brand: the real app mark, no tile -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,20">
          <Image Width="34" Height="34" Source="/Assets/app-icon-mark.png" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="IMM" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}" />
            <TextBlock Text="Infinite Modpack Manager" FontSize="10.5" Margin="0,2,0,0"
                       Foreground="{StaticResource ImmTextTertiaryBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- sections: RadioButton, checked state drives the accent bar -->
        <StackPanel Grid.Row="1">
          <RadioButton Style="{StaticResource ImmNavStyle}" GroupName="ImmNav" Margin="0,0,0,2"
                       IsChecked="{Binding IsLibrarySection, Mode=OneWay}"
                       Command="{Binding ShowSectionCommand}"
                       CommandParameter="{x:Static vm:AppSection.Library}"
                       AutomationProperties.Name="{Binding [Nav_Library], Source={x:Static loc:Loc.Instance}}"
                       ToolTip="{Binding [Tip_NavLibrary], Source={x:Static loc:Loc.Instance}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Library24" FontSize="16"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="{Binding [Nav_Library], Source={x:Static loc:Loc.Instance}}" Margin="10,0,0,0" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            </StackPanel>
          </RadioButton>

          <RadioButton Style="{StaticResource ImmNavStyle}" GroupName="ImmNav" Margin="0,0,0,2"
                       IsChecked="{Binding IsScannerSection, Mode=OneWay}"
                       Command="{Binding ShowSectionCommand}"
                       CommandParameter="{x:Static vm:AppSection.Scanner}"
                       AutomationProperties.Name="{Binding [Nav_Scanner], Source={x:Static loc:Loc.Instance}}"
                       ToolTip="{Binding [Tip_NavScanner], Source={x:Static loc:Loc.Instance}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ScanType24" FontSize="16"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="{Binding [Nav_Scanner], Source={x:Static loc:Loc.Instance}}" Margin="10,0,0,0" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            </StackPanel>
          </RadioButton>

          <RadioButton Style="{StaticResource ImmNavStyle}" GroupName="ImmNav" Margin="0,0,0,2"
                       IsChecked="{Binding IsSettingsSection, Mode=OneWay}"
                       Command="{Binding ShowSectionCommand}"
                       CommandParameter="{x:Static vm:AppSection.Settings}"
                       AutomationProperties.Name="{Binding [Nav_Settings], Source={x:Static loc:Loc.Instance}}"
                       ToolTip="{Binding [Tip_NavSettings], Source={x:Static loc:Loc.Instance}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Settings24" FontSize="16"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="{Binding [Nav_Settings], Source={x:Static loc:Loc.Instance}}" Margin="10,0,0,0" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            </StackPanel>
          </RadioButton>

          <RadioButton Style="{StaticResource ImmNavStyle}" GroupName="ImmNav" Margin="0,6,0,0"
                       IsChecked="False"
                       Command="{Binding OpenLogWindowCommand}"
                       AutomationProperties.Name="{Binding [Nav_Log], Source={x:Static loc:Loc.Instance}}"
                       ToolTip="{Binding [Tip_NavLog], Source={x:Static loc:Loc.Instance}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="SlideText24" FontSize="16"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="{Binding [Nav_Log], Source={x:Static loc:Loc.Instance}}" Margin="10,0,0,0" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <!-- status -->
        <StackPanel Grid.Row="3">
          <Border Height="1" Background="{StaticResource ImmLineBrush}" Margin="0,0,0,12" />
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                     Fill="{StaticResource ImmSuccessBrush}" />
            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource ImmTextSecondaryBrush}" />
          </StackPanel>
          <TextBlock Margin="14,5,0,0" FontSize="10.5" Foreground="{StaticResource ImmTextTertiaryBrush}"
                     Text="{Binding PacksInLibraryText}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ─────────── CENTER: section host ─────────── -->
    <Grid Grid.Column="1">

      <!-- library -->
      <Grid Margin="22,18,22,16"
            Visibility="{Binding IsLibrarySection, Converter={StaticResource BoolToVisibleConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding [Lib_Title], Source={x:Static loc:Loc.Instance}}" FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}" />
            <TextBlock Margin="10,0,0,4" VerticalAlignment="Bottom" FontSize="13"
                       Foreground="{StaticResource ImmTextTertiaryBrush}"
                       Text="{Binding PacksCountText}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                      Width="160" Height="34" FontSize="12.5" VerticalContentAlignment="Center" />
            <Border Background="{StaticResource ImmSurface2Brush}" BorderBrush="{StaticResource ImmLineBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="8,0,0,0" Padding="3">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ImmSegmentButtonStyle}" Command="{Binding SetGridViewCommand}"
                        ToolTip="{Binding [Lib_GridView], Source={x:Static loc:Loc.Instance}}">
                  <ui:SymbolIcon Symbol="GridDots24" FontSize="14"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource ImmSegmentButtonStyle}" Command="{Binding SetListViewCommand}"
                        ToolTip="{Binding [Lib_ListView], Source={x:Static loc:Loc.Instance}}">
                  <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="14"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- toolbar: actions left, search takes whatever is left (never collides) -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button Style="{StaticResource ImmPrimaryButtonStyle}" Height="34" Command="{Binding ImportCommand}"
                    ToolTip="{Binding [Lib_AddTip], Source={x:Static loc:Loc.Instance}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="White" />
                <TextBlock Text="{Binding [Lib_Add], Source={x:Static loc:Loc.Instance}}" Margin="7,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ImmGhostButtonStyle}" Margin="8,0,0,0"
                    Command="{Binding RescanCommand}" CommandParameter="{Binding SelectedEntry}"
                    ToolTip="{Binding [Lib_RescanTip], Source={x:Static loc:Loc.Instance}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13"
                               Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="{Binding [Lib_Rescan], Source={x:Static loc:Loc.Instance}}" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <ui:TextBox Grid.Column="1" Icon="{ui:SymbolIcon Search24}" PlaceholderText="{Binding [Lib_Search], Source={x:Static loc:Loc.Instance}}"
                      Height="34" FontSize="12.5" Margin="12,0,0,0" MinWidth="0"
                      HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <ListBox Grid.Row="2" x:Name="PacksList" ItemsSource="{Binding EntriesView}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.Style>
            <Style TargetType="ListBox">
              <Setter Property="ItemTemplate" Value="{StaticResource PackCardTemplate}" />
              <Setter Property="ItemsPanel">
                <Setter.Value>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="250" ItemHeight="202" />
                  </ItemsPanelTemplate>
                </Setter.Value>
              </Setter>
              <Setter Property="ItemContainerStyle">
                <Setter.Value>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Height" Value="188" />
                    <Setter Property="Margin" Value="0,4,14,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                  <Setter Property="ItemTemplate" Value="{StaticResource PackRowTemplate}" />
                  <Setter Property="ItemsPanel">
                    <Setter.Value>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,14,0" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <ContentPresenter />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>
        </ListBox>

        <!-- empty state -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVisibleConverter}}">
          <ui:SymbolIcon Symbol="Library24" FontSize="44" HorizontalAlignment="Center"
                         Foreground="{StaticResource ImmTextTertiaryBrush}" />
          <TextBlock Text="{Binding [Lib_EmptyTitle], Source={x:Static loc:Loc.Instance}}" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0"
                     HorizontalAlignment="Center" Foreground="{StaticResource ImmTextPrimaryBrush}" />
          <TextBlock Text="{Binding [Lib_EmptyHint], Source={x:Static loc:Loc.Instance}}" FontSize="12.5"
                     Margin="0,6,0,0" HorizontalAlignment="Center"
                     Foreground="{StaticResource ImmTextTertiaryBrush}" />
        </StackPanel>
      </Grid>

      <views:ScannerView Margin="22,18,22,16"
                         Visibility="{Binding IsScannerSection, Converter={StaticResource BoolToVisibleConverter}}" />

      <views:SettingsView Margin="22,18,22,16"
                          Visibility="{Binding IsSettingsSection, Converter={StaticResource BoolToVisibleConverter}}" />
    </Grid>

    <!-- ─────────── RIGHT: details (library only) ─────────── -->
    <Border Grid.Column="2" Width="340" Margin="0,18,18,18"
            Background="{StaticResource ImmDetailCardBrush}"
            BorderBrush="{StaticResource ImmLineBrush}" BorderThickness="1"
            CornerRadius="16" SnapsToDevicePixels="True"
            Visibility="{Binding IsLibrarySection, Converter={StaticResource BoolToVisibleConverter}}">
      <ContentControl Content="{Binding SelectedEntry}" Margin="0">
        <ContentControl.Resources>
          <DataTemplate DataType="{x:Type vm:LibraryEntryViewModel}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
                <StackPanel>
                  <!-- hero: cover + scrim + engine chip + name -->
                  <Grid Height="168">
                    <Border CornerRadius="11" ClipToBounds="True" Background="#0A1119">
                      <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                    </Border>
                    <Border CornerRadius="11" IsHitTestVisible="False">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#0006090E" Offset="0.25" />
                          <GradientStop Color="#8C06090E" Offset="0.66" />
                          <GradientStop Color="#F206090E" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <Border CornerRadius="11" BorderBrush="#1AFFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                    <Border Style="{StaticResource ImmCoverChipStyle}" Margin="8,8,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                 Fill="{StaticResource ImmAccentCyanBrush}" />
                        <TextBlock Text="{Binding EngineDisplayName}" FontSize="10.5" Margin="5,0,0,0"
                                   Foreground="#DCE6F4" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Bottom" Margin="12,0,12,9" TextWrapping="Wrap"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" />
                  </Grid>

                  <!-- two stats -->
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#08FFFFFF" BorderBrush="{StaticResource ImmLineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                      <StackPanel>
                        <TextBlock Text="{Binding PlaytimeText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ImmTextPrimaryBrush}" />
                        <TextBlock Text="{Binding [Common_InGame], Source={x:Static loc:Loc.Instance}}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{StaticResource ImmTextTertiaryBrush}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#08FFFFFF" BorderBrush="{StaticResource ImmLineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                      <StackPanel>
                        <TextBlock Text="{Binding LastPlayedText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ImmTextPrimaryBrush}" />
                        <TextBlock Text="{Binding [Common_LastLaunch], Source={x:Static loc:Loc.Instance}}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{StaticResource ImmTextTertiaryBrush}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- facts -->
                  <StackPanel Margin="2,12,2,0">
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding [Common_Game], Source={x:Static loc:Loc.Instance}}" FontSize="12" Foreground="{StaticResource ImmTextTertiaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding GameDisplayName}" FontSize="12"
                                 HorizontalAlignment="Right" Foreground="#CFD9E6" />
                    </Grid>
                    <Grid Margin="0,5"
                          Visibility="{Binding ProfileText, Converter={StaticResource NullToCollapsedConverter}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding [Common_ProfileMo2], Source={x:Static loc:Loc.Instance}}" FontSize="12" Foreground="{StaticResource ImmTextTertiaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding ProfileText}" FontSize="12"
                                 HorizontalAlignment="Right" Foreground="#CFD9E6" />
                    </Grid>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding [Common_Source], Source={x:Static loc:Loc.Instance}}" FontSize="12" Foreground="{StaticResource ImmTextTertiaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding SourceShortText}" FontSize="12"
                                 HorizontalAlignment="Right" Foreground="#CFD9E6" />
                    </Grid>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding [Common_Path], Source={x:Static loc:Loc.Instance}}" FontSize="12" Foreground="{StaticResource ImmTextTertiaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding RootPath}" FontSize="10.5"
                                 HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource ImmTextSecondaryBrush}"
                                 ToolTip="{Binding RootPath}" />
                    </Grid>
                  </StackPanel>

                  <!-- notes -->
                  <Border Margin="0,12,0,12" Background="#08FFFFFF" BorderBrush="{StaticResource ImmLineBrush}"
                          BorderThickness="1" CornerRadius="10" Padding="11,10"
                          Visibility="{Binding NotesText, Converter={StaticResource NullToCollapsedConverter}}">
                    <StackPanel>
                      <TextBlock Text="{Binding [Common_Notes], Source={x:Static loc:Loc.Instance}}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"
                                 Foreground="{StaticResource ImmTextTertiaryBrush}" />
                      <TextBlock Text="{Binding NotesText}" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                 Foreground="{StaticResource ImmTextSecondaryBrush}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <!-- anchored actions: the CTA never scrolls away -->
              <Border Grid.Row="1" BorderBrush="{StaticResource ImmLineBrush}" BorderThickness="0,1,0,0"
                      Padding="12">
                <StackPanel>
                  <Button Style="{StaticResource ImmLaunchButtonStyle}" Height="44" FontSize="13.5"
                          Tag="{Binding DataContext.IsGameRunning, RelativeSource={RelativeSource AncestorType=Page}}"
                          Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding [Det_Launch], Source={x:Static loc:Loc.Instance}}"
                          ToolTip="{Binding [Det_LaunchTip], Source={x:Static loc:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Play24" FontSize="14" Foreground="White" />
                      <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding [Det_Launch], Source={x:Static loc:Loc.Instance}}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DataContext.IsGameRunning, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                <Setter Property="Text" Value="{Binding [Det_LaunchRunning], Source={x:Static loc:Loc.Instance}}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Button>

                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ImmGhostButtonStyle}"
                            Command="{Binding DataContext.CreateBackupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}" Content="{Binding [Det_Backup], Source={x:Static loc:Loc.Instance}}" />
                    <Button Grid.Column="2" Style="{StaticResource ImmGhostButtonStyle}"
                            Command="{Binding DataContext.OpenPackFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}" Content="{Binding [Det_PackFolder], Source={x:Static loc:Loc.Instance}}" />
                  </Grid>

                  <Button Style="{StaticResource ImmGhostButtonStyle}" Height="32" Margin="0,8,0,0"
                          Command="{Binding DataContext.OpenMo2Command, RelativeSource={RelativeSource AncestorType=Page}}"
                          CommandParameter="{Binding}"
                          Visibility="{Binding IsMo2, Converter={StaticResource BoolToVisibleConverter}}"
                          ToolTip="{Binding [Det_OpenMo2Tip], Source={x:Static loc:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Settings24" FontSize="13"
                                     Foreground="{StaticResource ImmTextSecondaryBrush}" />
                      <TextBlock Text="{Binding [Det_OpenMo2], Source={x:Static loc:Loc.Instance}}" FontSize="11.5" Margin="7,0,0,0"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ContentControl.Resources>
      </ContentControl>
    </Border>

    <!-- ─────────── LAUNCH LOCK: while the pack's game process is alive the window
         takes no clicks at all (the CTA above shows the green «ЗАПУЩЕНА» state) ─────────── -->
    <Border Grid.ColumnSpan="3" Background="#2E060A10"
            Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibleConverter}}" />
  </Grid>
</Page>
