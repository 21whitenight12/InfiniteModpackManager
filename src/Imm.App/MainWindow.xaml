<ui:FluentWindow x:Class="Imm.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Infinite Modpack Manager"
                 Width="1400" Height="900"
                 MinWidth="1100" MinHeight="640"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto"
                 Background="Transparent">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Infinite Modpack Manager" />

    <Frame x:Name="PageHost" Grid.Row="1" NavigationUIVisibility="Hidden" />

    <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="2" />
    <ui:SnackbarPresenter x:Name="RootSnackbarPresenter" Grid.RowSpan="2"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,24,24" MaxWidth="420" />
  </Grid>
</ui:FluentWindow>
