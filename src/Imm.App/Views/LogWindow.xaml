<ui:FluentWindow x:Class="Imm.App.Views.LogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Лог — Infinite Modpack Manager"
                 Width="1100" Height="720" MinWidth="720" MinHeight="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 Background="Transparent">
  <Grid Background="{StaticResource ImmBgGradientBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Лог" Background="Transparent" />

    <Grid Grid.Row="1" Margin="16,4,16,8">
      <StackPanel Orientation="Horizontal">
        <ui:Button Appearance="Secondary" Command="{Binding CopyCommand}"
                   ToolTip="Скопировать весь лог в буфер обмена">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ClipboardCheckmark24" FontSize="14"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" />
            <TextBlock Text="Копировать" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ui:Button>
        <ui:Button Appearance="Secondary" Margin="8,0,0,0" Command="{Binding TogglePauseCommand}"
                   ToolTip="Пауза обновления (логирование продолжается)">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Pause24" FontSize="14"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" />
            <TextBlock Text="{Binding PauseButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ui:Button>
        <ui:Button Appearance="Secondary" Margin="8,0,0,0" Command="{Binding ClearViewCommand}"
                   ToolTip="Очистить только экран (файл лога не трогается)">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" />
            <TextBlock Text="Очистить экран" Margin="7,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ui:Button>
      </StackPanel>
      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                 Text="{Binding Lines.Count, StringFormat='{}{0} строк'}" FontSize="12"
                 Foreground="{StaticResource ImmTextSecondaryBrush}"
                 ToolTip="Строк в буфере (жёсткий лимит 4000)" />
    </Grid>

    <Border Grid.Row="2" Margin="16,0,16,0"
            Background="{StaticResource ImmBgCardBrush}"
            BorderBrush="{StaticResource ImmBorderBrush}" BorderThickness="1"
            CornerRadius="10" ClipToBounds="True">
      <ListBox x:Name="LogList"
               ItemsSource="{Binding Lines}"
               FontFamily="Consolas"
               FontSize="12"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Visible"
               VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,1" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </Border>

    <TextBlock Grid.Row="3" Margin="18,8,16,12" FontSize="11"
               Foreground="{StaticResource ImmTextSecondaryBrush}"
               Text="Файловый лог: %LOCALAPPDATA%\IMM\logs (или logs\ рядом с exe в portable-режиме)" />
  </Grid>
</ui:FluentWindow>
