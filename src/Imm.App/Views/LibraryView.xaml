<Page x:Class="Imm.App.Views.LibraryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Imm.App.ViewModels"
      Background="Transparent">

  <Page.Resources>
    <!-- Pack context menu (opened by the '...' button; DataContext = the card's entry VM).
         Declared BEFORE the card templates: StaticResource inside a template cannot forward-reference. -->
    <ContextMenu x:Key="PackMenu"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Профиль" Icon="{ui:SymbolIcon PeopleTeam24}" ItemsSource="{Binding AvailableProfiles}">
        <MenuItem.ItemContainerStyle>
          <Style TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Command" Value="{Binding DataContext.SetProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
          </Style>
        </MenuItem.ItemContainerStyle>
      </MenuItem>
      <MenuItem Header="Указать папку игры…" Icon="{ui:SymbolIcon FolderOpen24}"
                Command="{Binding ChooseGameFolderCommand}"
                ToolTip="Игра лежит отдельно от сборки — выбрать папку вручную" />
      <Separator />
      <MenuItem Header="Переименовать…" Icon="{ui:SymbolIcon Edit24}"
                Command="{Binding RenameCommand}" />
      <MenuItem Header="Сменить обложку…" Icon="{ui:SymbolIcon ImageEdit24}"
                Command="{Binding ChangeCoverCommand}" />
      <Separator />
      <MenuItem Header="Открыть папку сборки" Icon="{ui:SymbolIcon Folder24}"
                Command="{Binding OpenFolderCommand}" />
      <Separator />
      <MenuItem Header="Создать бэкап…" Icon="{ui:SymbolIcon Archive24}"
                Command="{Binding CreateBackupCommand}"
                ToolTip="zip профиля MO2 (или сейвов игры) в папку «Документы»" />
      <MenuItem Header="Открыть папку бэкапов" Icon="{ui:SymbolIcon Folder24}"
                Command="{Binding OpenBackupsFolderCommand}" />
      <Separator />
      <MenuItem Header="Ре-скан" Icon="{ui:SymbolIcon ArrowClockwise24}"
                Command="{Binding RescanCommand}" />
      <Separator />
      <MenuItem Header="Убрать из библиотеки" Icon="{ui:SymbolIcon Delete24}"
                Command="{Binding DeleteCommand}" />
    </ContextMenu>

    <!-- ============ GRID CARD (concept: cover, engine badge-pill, tabular meta rows) ============ -->
    <DataTemplate x:Key="PackCardTemplate" DataType="{x:Type vm:LibraryEntryViewModel}">
      <Border x:Name="CardRoot" BorderThickness="1"
              CornerRadius="10" Padding="0"
              Cursor="Hand">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ImmBgCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ImmCardBorderBrush}" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ImmBgCardHoverBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick"
                        Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Cover -->
          <Grid Grid.Row="0" Height="145" Margin="10,10,10,0" ClipToBounds="True">
            <Border CornerRadius="9" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#1A2438" Offset="0" />
                  <GradientStop Color="#0F1626" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Border CornerRadius="9" ClipToBounds="True"
                        Visibility="{Binding CoverPath, Converter={StaticResource NullToCollapsedConverter}}">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding CoverPath, Converter={StaticResource NullToVisibleConverter}}">
                  <ui:SymbolIcon Symbol="Library24" FontSize="34"
                                 Foreground="{StaticResource ImmTextSecondaryBrush}"
                                 HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource ImmTextSecondaryBrush}"
                             HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <!-- Selection badge -->
            <Border Width="22" Height="22" CornerRadius="11"
                    Background="{StaticResource ImmAccentBrush}" BorderBrush="#0D1420" BorderThickness="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibleConverter}}"
                    IsHitTestVisible="False" Panel.ZIndex="2">
              <ui:SymbolIcon Symbol="Checkmark24" FontSize="10" Foreground="White" />
            </Border>
            <Border CornerRadius="9,9,0,0" BorderBrush="{StaticResource ImmWarnBrush}" BorderThickness="2"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibleConverter}}"
                    IsHitTestVisible="False" />
          </Grid>

          <!-- Card body -->
          <StackPanel Grid.Row="1" Margin="12,10,12,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource ImmTextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis" />
              <ui:Button Grid.Column="1" Appearance="Secondary" Padding="4,1" Margin="6,0,0,0"
                         Icon="{ui:SymbolIcon MoreHorizontal24}"
                         Click="OpenCardMenu"
                         ContextMenu="{StaticResource PackMenu}"
                         ToolTip="Действия со сборкой" />
            </Grid>

            <!-- Engine badge pill + game row -->
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
              <Border Background="#262E8BFF" CornerRadius="4" Padding="7,2">
                <TextBlock Text="{Binding EngineDisplayName}" FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource ImmAccentCyanBrush}" />
              </Border>
              <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Rocket24" FontSize="13" Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="{Binding GameDisplayName}" FontSize="11" Margin="5,0,0,0"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <Separator Background="{StaticResource ImmBorderBrush}" Margin="0,10,0,8" />

            <!-- Tabular meta rows -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Последний запуск" FontSize="11"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastPlayedText}" FontSize="11"
                         Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Время в игре" FontSize="11" Margin="0,3,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlaytimeText}" FontSize="11" Margin="0,3,0,0"
                         Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource ImmAccentBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============ LIST ROW ============ -->
    <DataTemplate x:Key="PackRowTemplate" DataType="{x:Type vm:LibraryEntryViewModel}">
      <Border x:Name="RowRoot"
              Background="{StaticResource ImmBgCardBrush}"
              BorderBrush="{StaticResource ImmCardBorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
              Cursor="Hand">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick"
                        Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Height="63" CornerRadius="6" ClipToBounds="True" Background="#1A2438">
            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock Text="{Binding GameDisplayName}" FontSize="12"
                         Foreground="{StaticResource ImmAccentCyanBrush}" />
              <TextBlock Text="{Binding EngineDisplayName}" FontSize="12" Margin="10,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding LastPlayedText}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{StaticResource ImmTextSecondaryBrush}" />
          <TextBlock Grid.Column="4" Text="{Binding PlaytimeText}" FontSize="12" VerticalAlignment="Center"
                     Margin="24,0,0,0" HorizontalAlignment="Right" MinWidth="90" TextAlignment="Right"
                     Foreground="{StaticResource ImmTextPrimaryBrush}" />
          <ui:Button Grid.Column="6" Appearance="Secondary" Padding="4,1" VerticalAlignment="Center"
                     Icon="{ui:SymbolIcon MoreHorizontal24}"
                     Click="OpenCardMenu"
                     ContextMenu="{StaticResource PackMenu}"
                     ToolTip="Действия со сборкой" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="RowRoot" Property="BorderBrush" Value="{StaticResource ImmAccentBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Page.Resources>

  <!-- ============ 3-COLUMN LAYOUT (276 / * / 380) ============ -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="276" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>

    <!-- ============ LEFT COLUMN ============ -->
    <Border Grid.Column="0">
      <Grid Margin="20,24,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo: gradient ring + glow -->
        <Grid Grid.Row="0" Margin="2,0,0,28">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!-- App mark: transparent asset (no tile, no halo) — sits on the gradient like a native logo -->
          <Image Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0"
                 Source="/Assets/app-icon-mark.png" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="IMM" FontSize="23" FontWeight="Bold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}" />
            <TextBlock Text="Infinite Modpack Manager" FontSize="14"
                       Foreground="{StaticResource ImmTextSecondaryBrush}" />
          </StackPanel>
        </Grid>

        <!-- Nav -->
        <StackPanel Grid.Row="1">
          <Border Background="{StaticResource ImmBgCardHoverBrush}" CornerRadius="7" Padding="12,10" Margin="0,0,0,4">
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource ImmAccentColor}" Offset="0" />
                <GradientStop Color="Transparent" Offset="1" />
              </LinearGradientBrush>
            </Border.BorderBrush>
            <Border BorderThickness="3,0,0,0" Margin="-12,-10,0,-10" Padding="9,10" VerticalAlignment="Stretch">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="{StaticResource ImmAccentColor}" Offset="0" />
                  <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
              </Border.BorderBrush>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Library24" FontSize="18" Foreground="{StaticResource ImmAccentBrush}" />
                <TextBlock Text="Библиотека" FontSize="14" Margin="10,0,0,0" FontWeight="Medium"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </Border>
          </Border>

          <Border Padding="12,10" Margin="0,0,0,4" Opacity="0.55">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ScanType24" FontSize="18" Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Text="Сканер" FontSize="14" Margin="10,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </Border>

          <Border Padding="12,10" Opacity="0.55">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Text="Настройки" FontSize="14" Margin="10,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </Border>

          <Border Padding="12,10" Margin="0,4,0,0">
            <Button Style="{StaticResource ImmGhostButtonStyle}"
                    Command="{Binding OpenLogWindowCommand}"
                    HorizontalContentAlignment="Left" Padding="0"
                    ToolTip="Окно с подробным логом (Information+)">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="SlideText24" FontSize="18" Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="Лог" FontSize="14" Margin="10,0,0,0"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" />
              </StackPanel>
            </Button>
          </Border>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="3" Margin="2,0,0,0">
          <Separator Background="{StaticResource ImmBorderBrush}" Margin="0,0,0,12" />
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource ImmSuccessBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                       Foreground="{StaticResource ImmTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ CENTER COLUMN ============ -->
    <Grid Grid.Column="1" Margin="24,20,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,0">
        <TextBlock Text="Библиотека" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource ImmTextPrimaryBrush}" />
        <TextBlock Margin="10,0,0,1" VerticalAlignment="Bottom" FontSize="12"
                   Foreground="{StaticResource ImmTextSecondaryBrush}"
                   Text="{Binding Entries.Count, StringFormat='{}{0} сборки'}" />
      </StackPanel>

      <!-- Toolbar: import · rescan left / search · sort · views right -->
      <Grid Grid.Row="1" Margin="0,10,0,14">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ImmPrimaryButtonStyle}" Command="{Binding ImportCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Foreground="White" />
              <TextBlock Text="Добавить сборку" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ImmGhostButtonStyle}" Height="38" Margin="8,0,0,0"
                  Command="{Binding RescanCommand}" CommandParameter="{Binding SelectedEntry}"
                  ToolTip="Ре-скан выбранной сборки">
            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" />
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <ui:TextBox Icon="{ui:SymbolIcon Search24}" PlaceholderText="Поиск сборок…"
                      Width="200" Height="34" FontSize="13" VerticalContentAlignment="Center"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}"
                    Width="150" Height="34" FontSize="13" Margin="8,0,0,0"
                    VerticalContentAlignment="Center" />
          <Border Background="{StaticResource ImmBgCardBrush}" BorderBrush="{StaticResource ImmBorderBrush}"
                  BorderThickness="1" CornerRadius="7" Margin="8,0,0,0" Padding="4">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource ImmSegmentButtonStyle}" Command="{Binding SetGridViewCommand}"
                      Opacity="{Binding IsGridView, Converter={StaticResource BoolToOpacityConverter}}"
                      ToolTip="Сетка">
                <ui:SymbolIcon Symbol="GridDots24" FontSize="16"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </Button>
              <Button Style="{StaticResource ImmSegmentButtonStyle}" Command="{Binding SetListViewCommand}"
                      Opacity="{Binding IsGridView, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=invert}"
                      ToolTip="Список">
                <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Cards grid (ListBox + VirtualizingWrapPanel, concept rule) -->
      <ListBox Grid.Row="2" x:Name="PacksList"
               ItemsSource="{Binding EntriesView}"
               Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.Style>
          <Style TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource PackCardTemplate}" />
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
              <Setter.Value>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Width" Value="290" />
                  <Setter Property="Height" Value="350" />
                  <Setter Property="Margin" Value="0,0,16,12" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsGridView}" Value="False">
                <Setter Property="ItemTemplate" Value="{StaticResource PackRowTemplate}" />
                <Setter Property="ItemsPanel">
                  <Setter.Value>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                  <Setter.Value>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Margin" Value="0,0,0,8" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListBox.Style>
      </ListBox>

      <!-- Empty state -->
      <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVisibleConverter}}">
        <ui:SymbolIcon Symbol="Library24" FontSize="64"
                       Foreground="{StaticResource ImmTextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        <TextBlock Text="Библиотека пуста" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"
                   Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Перетащите папку сборки в окно или нажмите «Добавить сборку»" FontSize="13"
                   Margin="0,6,0,0" HorizontalAlignment="Center"
                   Foreground="{StaticResource ImmTextSecondaryBrush}" />
      </StackPanel>
    </Grid>

    <!-- ============ RIGHT COLUMN: elevated detail card ============ -->
    <Border Grid.Column="2" Margin="12,16,16,16"
            Background="{StaticResource ImmDetailCardBrush}"
            BorderBrush="{StaticResource ImmCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
      <ContentControl Content="{Binding SelectedEntry}" Margin="20,20,20,16">
        <ContentControl.Resources>
          <DataTemplate DataType="{x:Type vm:LibraryEntryViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- Cover -->
                <Border Height="180" CornerRadius="12" ClipToBounds="True" Margin="0">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#1A2438" Offset="0" />
                      <GradientStop Color="#0F1626" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid ClipToBounds="True">
                    <Border CornerRadius="12" ClipToBounds="True"
                            Visibility="{Binding CoverPath, Converter={StaticResource NullToCollapsedConverter}}">
                      <Border.Background>
                      <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" />
                      </Border.Background>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding CoverPath, Converter={StaticResource NullToVisibleConverter}}">
                      <ui:SymbolIcon Symbol="Library24" FontSize="36"
                                     Foreground="{StaticResource ImmTextSecondaryBrush}"
                                     HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{StaticResource ImmTextSecondaryBrush}"
                                 HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <ui:SymbolIcon Symbol="Rocket24" FontSize="15" Foreground="{StaticResource ImmAccentCyanBrush}" />
                  <TextBlock Text="{Binding GameDisplayName}" FontSize="13" Margin="8,0,0,0"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Separator Background="{StaticResource ImmBorderBrush}" Margin="0,14,0,10" />

                <!-- Info rows: label left, value right -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Движок" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EngineDisplayName}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Источник" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,6,0,0" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceText}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Последний запуск" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,6,0,0" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastPlayedText}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Время в игре" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,6,0,0" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlaytimeText}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Профиль MO2" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,6,0,0"
                             Visibility="{Binding ProfileText, Converter={StaticResource NullToCollapsedConverter}}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileText}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0"
                             Visibility="{Binding ProfileText, Converter={StaticResource NullToCollapsedConverter}}" />
                </Grid>

                <!-- Launch: wide canon accent (strategy wired in Phase 2) -->
                <Button Style="{StaticResource ImmPrimaryButtonStyle}" Height="44" FontSize="15" FontWeight="Bold"
                        Margin="0,16,0,0"
                        Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        ToolTip="Запустить сборку">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="White" />
                    <TextBlock Text="ЗАПУСТИТЬ" Margin="10,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Style="{StaticResource ImmGhostButtonStyle}" HorizontalContentAlignment="Center"
                          Command="{Binding DataContext.OpenPackFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="OpenFolder24" FontSize="14"
                                     Foreground="{StaticResource ImmTextSecondaryBrush}" />
                      <TextBlock Text="Папка сборки" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource ImmGhostButtonStyle}" HorizontalContentAlignment="Center"
                          Command="{Binding DataContext.RescanCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14"
                                     Foreground="{StaticResource ImmTextSecondaryBrush}" />
                      <TextBlock Text="Ре-скан" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- Notes -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding NotesText, Converter={StaticResource NullToCollapsedConverter}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Заметки" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="Edit24" FontSize="14"
                                   Foreground="{StaticResource ImmTextSecondaryBrush}"
                                   ToolTip="Редактирование заметок появится позже" />
                  </Grid>
                  <Border Background="#101828" BorderBrush="{StaticResource ImmBorderBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                    <TextBlock Text="{Binding NotesText}" FontSize="12" TextWrapping="Wrap" LineHeight="17"
                               Foreground="{StaticResource ImmTextSecondaryBrush}" />
                  </Border>
                </StackPanel>

                <TextBlock Text="Путь" FontSize="12" Margin="0,14,0,0"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="{Binding RootPath}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </ScrollViewer>
          </DataTemplate>
        </ContentControl.Resources>
      </ContentControl>
    </Border>
  </Grid>
</Page>
