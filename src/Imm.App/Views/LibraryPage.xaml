<Page x:Class="Imm.App.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Imm.App.ViewModels"
      Background="Transparent">

  <Page.Resources>
    <!-- Pack card template (design canon: cover 16:9, title, game+engine, date+playtime) -->
    <DataTemplate x:Key="PackCardTemplate" DataType="{x:Type vm:LibraryEntryViewModel}">
      <Border x:Name="CardRoot"
              Background="{StaticResource ImmBgCardBrush}"
              BorderBrush="Transparent" BorderThickness="2"
              CornerRadius="8" Padding="0"
              Cursor="Hand">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick"
                        Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Cover -->
          <Grid Grid.Row="0" Height="150" ClipToBounds="True">
            <Border CornerRadius="8,8,0,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#1A2438" Offset="0" />
                  <GradientStop Color="#0F1626" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                       Visibility="{Binding CoverPath, Converter={StaticResource NullToCollapsedConverter}}" />
                <ui:SymbolIcon Symbol="Library24" FontSize="40"
                               Foreground="{StaticResource ImmTextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border CornerRadius="8" BorderBrush="{StaticResource ImmWarnBrush}" BorderThickness="2"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibleConverter}}"
                    IsHitTestVisible="False" />
          </Grid>

          <!-- Card body -->
          <StackPanel Grid.Row="1" Margin="12,10,12,12">
            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <ui:SymbolIcon Symbol="Rocket24" FontSize="14"
                                 Foreground="{StaticResource ImmTextSecondaryBrush}" />
                  <TextBlock Text="{Binding GameDisplayName}" FontSize="12" Margin="6,0,0,0"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <ui:SymbolIcon Symbol="Flowchart24" FontSize="14"
                                 Foreground="{StaticResource ImmTextSecondaryBrush}" />
                  <TextBlock Text="{Binding EngineDisplayName}" FontSize="12" Margin="6,0,0,0"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="14"
                                 Foreground="{StaticResource ImmTextSecondaryBrush}" />
                  <TextBlock Text="{Binding LastPlayedText}" FontSize="12" Margin="6,0,0,0"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" />
                  <ui:SymbolIcon Symbol="Clock24" FontSize="14" Margin="10,0,0,0"
                                 Foreground="{StaticResource ImmTextSecondaryBrush}" />
                  <TextBlock Text="{Binding PlaytimeText}" FontSize="12" Margin="6,0,0,0"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>
              <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon MoreHorizontal24}" Appearance="Secondary"
                         VerticalAlignment="Top" Padding="6,4"
                         Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         CommandParameter="{Binding}"
                         ToolTip="Убрать из библиотеки" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource ImmAccentBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Sidebar -->
      <ColumnDefinition Width="232" />
      <!-- Content -->
      <ColumnDefinition Width="*" />
      <!-- Details -->
      <ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>

    <!-- ============ SIDEBAR ============ -->
    <Border Grid.Column="0" Background="{StaticResource ImmBgSidebarBrush}">
      <Grid Margin="16,20,16,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,24">
          <Border Width="40" Height="40" CornerRadius="20" Background="#0D1526"
                  BorderBrush="{StaticResource ImmAccentCyanBrush}" BorderThickness="2">
            <TextBlock Text="∞" FontSize="22" FontWeight="Bold"
                       Foreground="#E8B84B"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="IMM" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}" />
            <TextBlock Text="Infinite Modpack Manager" FontSize="10"
                       Foreground="{StaticResource ImmTextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- Nav -->
        <StackPanel Grid.Row="1">
          <Border Background="{StaticResource ImmBgCardHoverBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource ImmAccentColor}" Offset="0" />
                <GradientStop Color="Transparent" Offset="1" />
              </LinearGradientBrush>
            </Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Library24" FontSize="18" Foreground="{StaticResource ImmAccentBrush}" />
              <TextBlock Text="Библиотека" FontSize="14" Margin="10,0,0,0" FontWeight="Medium"
                         Foreground="{StaticResource ImmTextPrimaryBrush}" />
            </StackPanel>
          </Border>

          <Border Padding="12,10" Margin="0,0,0,4" Opacity="0.5">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ScanType24" FontSize="18" Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Text="Сканер" FontSize="14" Margin="10,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </Border>

          <Border Padding="12,10" Opacity="0.5">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Text="Настройки" FontSize="14" Margin="10,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="3" Margin="4,0,0,0">
          <Separator Background="{StaticResource ImmBorderBrush}" Margin="0,0,0,12" />
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource ImmSuccessBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                       Foreground="{StaticResource ImmTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ CONTENT ============ -->
    <Grid Grid.Column="1" Margin="24,20,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
        <TextBlock Text="Библиотека" FontSize="26" FontWeight="SemiBold"
                   Foreground="{StaticResource ImmTextPrimaryBrush}" />
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Bottom" FontSize="13"
                   Foreground="{StaticResource ImmTextSecondaryBrush}"
                   Text="{Binding Entries.Count, StringFormat='Установленные сборки ({0})'}" />
      </StackPanel>

      <!-- Toolbar -->
      <Grid Grid.Row="1" Margin="0,12,0,16">
        <StackPanel Orientation="Horizontal">
          <ui:Button Appearance="Primary" Command="{Binding ImportCommand}" Padding="16,8"
                     Icon="{ui:SymbolIcon FolderAdd24}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Добавить сборку" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>
          <ui:Button Command="{Binding RescanCommand}" CommandParameter="{Binding SelectedEntry}"
                     Padding="12,8" Margin="8,0,0,0" Appearance="Secondary"
                     Icon="{ui:SymbolIcon ArrowClockwise24}"
                     ToolTip="Ре-скан выбранной сборки" />
        </StackPanel>
      </Grid>

      <!-- Cards -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Entries}"
                      ItemTemplate="{StaticResource PackCardTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style>
              <Setter Property="FrameworkElement.Width" Value="300" />
              <Setter Property="FrameworkElement.Margin" Value="0,0,16,16" />
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>
      </ScrollViewer>

      <!-- Empty state -->
      <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVisibleConverter}}">
        <ui:SymbolIcon Symbol="Library24" FontSize="64"
                       Foreground="{StaticResource ImmTextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        <TextBlock Text="Библиотека пуста" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"
                   Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Перетащите папку сборки в окно или нажмите «Добавить сборку»" FontSize="13"
                   Margin="0,6,0,0" HorizontalAlignment="Center"
                   Foreground="{StaticResource ImmTextSecondaryBrush}" />
      </StackPanel>
    </Grid>

    <!-- ============ DETAILS ============ -->
    <Border Grid.Column="2" Background="{StaticResource ImmBgCardBrush}" Padding="20">
      <ContentControl Content="{Binding SelectedEntry}">
        <ContentControl.Resources>
          <DataTemplate DataType="{x:Type vm:LibraryEntryViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- Cover -->
                <Border Height="170" CornerRadius="8" ClipToBounds="True">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#1A2438" Offset="0" />
                      <GradientStop Color="#0F1626" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                         Visibility="{Binding CoverPath, Converter={StaticResource NullToCollapsedConverter}}" />
                </Border>

                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" TextWrapping="Wrap" />

                <StackPanel Margin="0,14,0,0">
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="16" Foreground="{StaticResource ImmTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding GameDisplayName}" FontSize="13" Margin="10,0,0,0"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Flowchart24" FontSize="16" Foreground="{StaticResource ImmTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding EngineDisplayName}" FontSize="13" Margin="10,0,0,0"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Clock24" FontSize="16" Foreground="{StaticResource ImmTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding PlaytimeText}" FontSize="13" Margin="10,0,0,0"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="16" Foreground="{StaticResource ImmTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding LastPlayedText}" FontSize="13" Margin="10,0,0,0"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>

                <Button Content="ЗАПУСТИТЬ" Margin="0,18,0,0" Height="44" FontSize="15" FontWeight="Bold"
                        Background="{StaticResource ImmAccentBrush}" Foreground="White"
                        BorderThickness="0" IsEnabled="False"
                        ToolTip="Запуск появится в фазе запуска (Phase 2)" />

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:Button Content="Папка сборки" HorizontalContentAlignment="Center"
                             Icon="{ui:SymbolIcon OpenFolder24}"
                             Command="{Binding DataContext.OpenPackFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                             CommandParameter="{Binding}" />
                  <ui:Button Grid.Column="2" Content="Ре-скан" HorizontalContentAlignment="Center"
                             Icon="{ui:SymbolIcon ArrowClockwise24}"
                             Command="{Binding DataContext.RescanCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                             CommandParameter="{Binding}" />
                </Grid>

                <TextBlock Text="Путь" FontSize="12" Margin="0,18,0,0"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="{Binding RootPath}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </ScrollViewer>
          </DataTemplate>
        </ContentControl.Resources>
      </ContentControl>
    </Border>
  </Grid>
</Page>
