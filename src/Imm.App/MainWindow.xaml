<ui:FluentWindow x:Class="Imm.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Infinite Modpack Manager"
                 Width="1100" Height="720"
                 MinWidth="820" MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Infinite Modpack Manager" />

    <Grid Grid.Row="1">
      <TextBlock Text="Modpack library will appear here (Phase 1)."
                 FontSize="18" FontWeight="Medium"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>

    <ui:InfoBar Grid.Row="2" IsOpen="True" IsClosable="False"
                Severity="Informational"
                Title="Phase 0 shell"
                Message="{Binding StatusText}" />

    <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.Row="0" Grid.RowSpan="3" />
    <ui:SnackbarPresenter x:Name="RootSnackbarPresenter" Grid.Row="0" Grid.RowSpan="3" />
  </Grid>
</ui:FluentWindow>
