<ui:FluentWindow x:Class="Imm.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Infinite Modpack Manager"
                 Width="1400" Height="1000"
                 MinWidth="1100" MinHeight="640"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 Background="Transparent">

  <Grid Background="{StaticResource ImmBgGradientBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Accent aurora behind all content (titlebar transparent → gradient flows through) -->
    <Rectangle Grid.RowSpan="2" Fill="{StaticResource ImmAccentGlowBrush}" IsHitTestVisible="False" />

    <!-- Column tints: full window height (titlebar included), fade reaching into center -->
    <Rectangle Grid.RowSpan="2" Width="340" HorizontalAlignment="Left"
               Fill="{StaticResource ImmSidebarTintBrush}" IsHitTestVisible="False" />
    <Rectangle Grid.RowSpan="2" Width="460" HorizontalAlignment="Right"
               Fill="{StaticResource ImmPanelTintBrush}" IsHitTestVisible="False" />

    <ui:TitleBar Grid.Row="0" Title="Infinite Modpack Manager" Background="Transparent" />

    <Frame x:Name="PageHost" Grid.Row="1" NavigationUIVisibility="Hidden"
           Background="Transparent" />

    <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.RowSpan="2" />
    <ui:SnackbarPresenter x:Name="RootSnackbarPresenter" Grid.RowSpan="2"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,24,24" MaxWidth="420" />
  </Grid>
</ui:FluentWindow>
