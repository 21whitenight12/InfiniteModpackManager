<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:conv="clr-namespace:Imm.App.Converters">

  <!-- IMM design canon (design/DESIGN.md): cold navy dark theme -->

  <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
  <conv:BoolToVisibleConverter x:Key="BoolToVisibleConverter" />

  <Color x:Key="ImmBgBaseColor">#0D1420</Color>
  <Color x:Key="ImmBgCardColor">#151D2E</Color>
  <Color x:Key="ImmBgCardHoverColor">#1A2438</Color>
  <Color x:Key="ImmAccentColor">#2E8BFF</Color>
  <Color x:Key="ImmAccentCyanColor">#38BDF8</Color>

  <SolidColorBrush x:Key="ImmBgBaseBrush" Color="{StaticResource ImmBgBaseColor}" />
  <SolidColorBrush x:Key="ImmBgSidebarBrush" Color="#0A101B" />
  <SolidColorBrush x:Key="ImmBgCardBrush" Color="{StaticResource ImmBgCardColor}" />
  <SolidColorBrush x:Key="ImmBgCardHoverBrush" Color="{StaticResource ImmBgCardHoverColor}" />
  <SolidColorBrush x:Key="ImmAccentBrush" Color="{StaticResource ImmAccentColor}" />
  <SolidColorBrush x:Key="ImmAccentCyanBrush" Color="{StaticResource ImmAccentCyanColor}" />
  <SolidColorBrush x:Key="ImmTextPrimaryBrush" Color="#F5F7FA" />
  <SolidColorBrush x:Key="ImmTextSecondaryBrush" Color="#8A94A6" />
  <SolidColorBrush x:Key="ImmSuccessBrush" Color="#2ECC71" />
  <SolidColorBrush x:Key="ImmWarnBrush" Color="#E67E22" />
  <SolidColorBrush x:Key="ImmBorderBrush" Color="#223048" />

  <CornerRadius x:Key="ImmCardCornerRadius">8</CornerRadius>
  <Thickness x:Key="ImmCardPadding">14</Thickness>
</ResourceDictionary>
