<Page x:Class="Imm.App.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Imm.App.ViewModels"
      Background="Transparent">

  <Page.Resources>
    <!-- ============ GRID CARD (design canon: tall cover, tabular meta rows, ··· menu) ============ -->
    <DataTemplate x:Key="PackCardTemplate" DataType="{x:Type vm:LibraryEntryViewModel}">
      <Border x:Name="CardRoot"
              Background="{StaticResource ImmBgCardBrush}"
              BorderBrush="Transparent" BorderThickness="2"
              CornerRadius="10" Padding="0"
              Cursor="Hand">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick"
                        Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Cover -->
          <Grid Grid.Row="0" Height="168" ClipToBounds="True">
            <Border CornerRadius="9,9,0,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#1A2438" Offset="0" />
                  <GradientStop Color="#0F1626" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                       Visibility="{Binding CoverPath, Converter={StaticResource NullToCollapsedConverter}}" />
                <ui:SymbolIcon Symbol="Library24" FontSize="40"
                               Foreground="{StaticResource ImmTextSecondaryBrush}"
                               Visibility="{Binding CoverPath, Converter={StaticResource NullToVisibleConverter}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <!-- Selection badge (reference: accent circle + checkmark, top-right) -->
            <Border x:Name="SelectionBadge" Width="26" Height="26" CornerRadius="13"
                    Background="{StaticResource ImmAccentBrush}" BorderBrush="#0D1420" BorderThickness="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibleConverter}}"
                    IsHitTestVisible="False" Panel.ZIndex="2">
              <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="White" />
            </Border>
            <Border CornerRadius="9,9,0,0" BorderBrush="{StaticResource ImmWarnBrush}" BorderThickness="2"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibleConverter}}"
                    IsHitTestVisible="False" />
          </Grid>

          <!-- Card body -->
          <StackPanel Grid.Row="1" Margin="14,10,14,10">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
              <ui:SymbolIcon Symbol="Rocket24" FontSize="13"
                             Foreground="{StaticResource ImmAccentCyanBrush}" />
              <TextBlock Text="{Binding GameDisplayName}" FontSize="12" Margin="6,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding EngineDisplayName}" FontSize="12" Margin="19,3,0,0"
                       Foreground="{StaticResource ImmTextSecondaryBrush}" />

            <Separator Background="{StaticResource ImmBorderBrush}" Margin="0,10,0,8" />

            <!-- Tabular meta rows (label left, value right — reference style) -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Последний запуск" FontSize="12"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastPlayedText}" FontSize="12"
                         Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Время в игре" FontSize="12" Margin="0,3,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlaytimeText}" FontSize="12" Margin="0,3,0,0"
                         Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" />
            </Grid>

            <ui:Button HorizontalAlignment="Center" Appearance="Secondary" Padding="8,2" Margin="0,8,0,0"
                       Icon="{ui:SymbolIcon MoreHorizontal24}"
                       Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}"
                       ToolTip="Убрать из библиотеки" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource ImmAccentBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
      <DataTemplate.Resources>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
              <Setter Property="Opacity" Value="0.96" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataTemplate.Resources>
    </DataTemplate>

    <!-- ============ LIST ROW ============ -->
    <DataTemplate x:Key="PackRowTemplate" DataType="{x:Type vm:LibraryEntryViewModel}">
      <Border x:Name="RowRoot"
              Background="{StaticResource ImmBgCardBrush}"
              BorderBrush="Transparent" BorderThickness="1"
              CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
              Cursor="Hand">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick"
                        Command="{Binding DataContext.SelectEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Height="63" CornerRadius="6" ClipToBounds="True" Background="#1A2438">
            <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock Text="{Binding GameDisplayName}" FontSize="12"
                         Foreground="{StaticResource ImmAccentCyanBrush}" />
              <TextBlock Text="{Binding EngineDisplayName}" FontSize="12" Margin="10,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding LastPlayedText}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{StaticResource ImmTextSecondaryBrush}" />
          <TextBlock Grid.Column="4" Text="{Binding PlaytimeText}" FontSize="12" VerticalAlignment="Center"
                     Margin="24,0,0,0" HorizontalAlignment="Right" MinWidth="90" TextAlignment="Right"
                     Foreground="{StaticResource ImmTextPrimaryBrush}" />
          <ui:Button Grid.Column="6" Appearance="Secondary" Padding="4,1" VerticalAlignment="Center"
                     Icon="{ui:SymbolIcon MoreHorizontal24}"
                     Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                     CommandParameter="{Binding}"
                     ToolTip="Убрать из библиотеки" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="RowRoot" Property="BorderBrush" Value="{StaticResource ImmAccentBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Sidebar -->
      <ColumnDefinition Width="232" />
      <!-- Content -->
      <ColumnDefinition Width="*" />
      <!-- Details -->
      <ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>

    <!-- ============ SIDEBAR ============ -->
    <Border Grid.Column="0" Background="{StaticResource ImmBgSidebarBrush}">
      <Grid Margin="16,20,16,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo: gradient ring + glow (reference mark) -->
        <Grid Grid.Row="0" Margin="4,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
            <Ellipse Fill="{StaticResource ImmAccentBrush}" Opacity="0.18">
              <Ellipse.Effect>
                <BlurEffect Radius="14" />
              </Ellipse.Effect>
            </Ellipse>
            <Border Width="40" Height="40" CornerRadius="20">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#16324F" Offset="0" />
                  <GradientStop Color="#0D1B33" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{StaticResource ImmAccentCyanColor}" Offset="0" />
                  <GradientStop Color="{StaticResource ImmAccentColor}" Offset="0.55" />
                  <GradientStop Color="#E8B84B" Offset="1" />
                </LinearGradientBrush>
              </Border.BorderBrush>
              <Border BorderThickness="2" CornerRadius="19">
                <TextBlock Text="∞" FontSize="21" FontWeight="Bold" Margin="0,-2,0,0"
                           Foreground="#F2D06B"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="IMM" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource ImmTextPrimaryBrush}" />
            <TextBlock Text="Infinite Modpack Manager" FontSize="10"
                       Foreground="{StaticResource ImmTextSecondaryBrush}" />
          </StackPanel>
        </Grid>

        <!-- Nav -->
        <StackPanel Grid.Row="1">
          <Border Background="{StaticResource ImmBgCardHoverBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource ImmAccentColor}" Offset="0" />
                <GradientStop Color="Transparent" Offset="1" />
              </LinearGradientBrush>
            </Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Library24" FontSize="18" Foreground="{StaticResource ImmAccentBrush}" />
              <TextBlock Text="Библиотека" FontSize="14" Margin="10,0,0,0" FontWeight="Medium"
                         Foreground="{StaticResource ImmTextPrimaryBrush}" />
            </StackPanel>
          </Border>

          <Border Padding="12,10" Margin="0,0,0,4" Opacity="0.5">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ScanType24" FontSize="18" Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Text="Сканер" FontSize="14" Margin="10,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </Border>

          <Border Padding="12,10" Opacity="0.5">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{StaticResource ImmTextSecondaryBrush}" />
              <TextBlock Text="Настройки" FontSize="14" Margin="10,0,0,0"
                         Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="3" Margin="4,0,0,0">
          <Separator Background="{StaticResource ImmBorderBrush}" Margin="0,0,0,12" />
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource ImmSuccessBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="8,0,0,0"
                       Foreground="{StaticResource ImmTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ CONTENT ============ -->
    <Grid Grid.Column="1" Margin="24,20,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
        <TextBlock Text="Библиотека" FontSize="26" FontWeight="SemiBold"
                   Foreground="{StaticResource ImmTextPrimaryBrush}" />
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Bottom" FontSize="13"
                   Foreground="{StaticResource ImmTextSecondaryBrush}"
                   Text="{Binding Entries.Count, StringFormat='Установленные сборки ({0})'}" />
      </StackPanel>

      <!-- Toolbar: import left · sort + view switch right (reference) -->
      <Grid Grid.Row="1" Margin="0,12,0,16">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ImmPrimaryButtonStyle}" Command="{Binding ImportCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Foreground="White" />
              <TextBlock Text="Добавить сборку" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ImmGhostButtonStyle}" Margin="8,0,0,0"
                  Command="{Binding RescanCommand}" CommandParameter="{Binding SelectedEntry}"
                  ToolTip="Ре-скан выбранной сборки">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}"
                    Width="170" Height="34" FontSize="13"
                    VerticalContentAlignment="Center" />
          <Border Background="{StaticResource ImmBgCardBrush}" BorderBrush="{StaticResource ImmBorderBrush}"
                  BorderThickness="1" CornerRadius="7" Margin="8,0,0,0" Padding="4">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource ImmSegmentButtonStyle}" Command="{Binding SetGridViewCommand}"
                      Opacity="{Binding IsGridView, Converter={StaticResource BoolToOpacityConverter}}"
                      ToolTip="Сетка">
                <ui:SymbolIcon Symbol="GridDots24" FontSize="16"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </Button>
              <Button Style="{StaticResource ImmSegmentButtonStyle}" Command="{Binding SetListViewCommand}"
                      Opacity="{Binding IsGridView, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=invert}"
                      ToolTip="Список">
                <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Cards (grid) -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding EntriesView}" ItemTemplate="{StaticResource PackCardTemplate}"
                        Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibleConverter}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style>
                <Setter Property="FrameworkElement.Width" Value="290" />
                <Setter Property="FrameworkElement.Height" Value="384" />
                <Setter Property="FrameworkElement.Margin" Value="0,0,16,16" />
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>

          <!-- Rows (list) -->
          <ItemsControl ItemsSource="{Binding EntriesView}" ItemTemplate="{StaticResource PackRowTemplate}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsGridView}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Empty state -->
      <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVisibleConverter}}">
        <ui:SymbolIcon Symbol="Library24" FontSize="64"
                       Foreground="{StaticResource ImmTextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        <TextBlock Text="Библиотека пуста" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"
                   Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Перетащите папку сборки в окно или нажмите «Добавить сборку»" FontSize="13"
                   Margin="0,6,0,0" HorizontalAlignment="Center"
                   Foreground="{StaticResource ImmTextSecondaryBrush}" />
      </StackPanel>
    </Grid>

    <!-- ============ DETAILS ============ -->
    <Border Grid.Column="2" Background="{StaticResource ImmBgCardBrush}" Padding="20">
      <ContentControl Content="{Binding SelectedEntry}">
        <ContentControl.Resources>
          <DataTemplate DataType="{x:Type vm:LibraryEntryViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- Cover -->
                <Border Height="168" CornerRadius="10" ClipToBounds="True">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#1A2438" Offset="0" />
                      <GradientStop Color="#0F1626" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid>
                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                           Visibility="{Binding CoverPath, Converter={StaticResource NullToCollapsedConverter}}" />
                    <ui:SymbolIcon Symbol="Library24" FontSize="40"
                                   Foreground="{StaticResource ImmTextSecondaryBrush}"
                                   Visibility="{Binding CoverPath, Converter={StaticResource NullToVisibleConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" TextWrapping="Wrap" />

                <!-- Game identity row -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <ui:SymbolIcon Symbol="Rocket24" FontSize="15" Foreground="{StaticResource ImmAccentCyanBrush}" />
                  <TextBlock Text="{Binding GameDisplayName}" FontSize="13" Margin="8,0,0,0"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Separator Background="{StaticResource ImmBorderBrush}" Margin="0,14,0,10" />

                <!-- Info rows: label left, value right (reference) -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Движок" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EngineDisplayName}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Источник" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,6,0,0" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceText}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Последний запуск" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,6,0,0" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastPlayedText}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Время в игре" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,6,0,0" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlaytimeText}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Профиль MO2" FontSize="12"
                             Foreground="{StaticResource ImmTextSecondaryBrush}" Margin="0,6,0,0"
                             Visibility="{Binding ProfileText, Converter={StaticResource NullToCollapsedConverter}}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileText}" FontSize="12"
                             Foreground="{StaticResource ImmTextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,6,0,0"
                             Visibility="{Binding ProfileText, Converter={StaticResource NullToCollapsedConverter}}" />
                </Grid>

                <!-- Launch: wide canon accent (Phase 2 wires the command) -->
                <Button Style="{StaticResource ImmPrimaryButtonStyle}" Height="44" FontSize="15" FontWeight="Bold"
                        Margin="0,18,0,0" IsEnabled="False"
                        ToolTip="Запуск появится в фазе запуска (Phase 2)">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="White" />
                    <TextBlock Text="ЗАПУСТИТЬ" Margin="10,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Style="{StaticResource ImmGhostButtonStyle}" HorizontalContentAlignment="Center"
                          Command="{Binding DataContext.OpenPackFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="OpenFolder24" FontSize="14"
                                     Foreground="{StaticResource ImmTextSecondaryBrush}" />
                      <TextBlock Text="Папка сборки" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource ImmGhostButtonStyle}" HorizontalContentAlignment="Center"
                          Command="{Binding DataContext.RescanCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14"
                                     Foreground="{StaticResource ImmTextSecondaryBrush}" />
                      <TextBlock Text="Ре-скан" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- Notes (reference section) -->
                <StackPanel Margin="0,18,0,0"
                            Visibility="{Binding NotesText, Converter={StaticResource NullToCollapsedConverter}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Заметки" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource ImmTextPrimaryBrush}" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="Edit24" FontSize="14"
                                   Foreground="{StaticResource ImmTextSecondaryBrush}"
                                   ToolTip="Редактирование заметок появится позже" />
                  </Grid>
                  <Border Background="#101828" BorderBrush="{StaticResource ImmBorderBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                    <TextBlock Text="{Binding NotesText}" FontSize="12" TextWrapping="Wrap" LineHeight="17"
                               Foreground="{StaticResource ImmTextSecondaryBrush}" />
                  </Border>
                </StackPanel>

                <TextBlock Text="Путь" FontSize="12" Margin="0,18,0,0"
                           Foreground="{StaticResource ImmTextSecondaryBrush}" />
                <TextBlock Text="{Binding RootPath}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource ImmTextPrimaryBrush}" />
              </StackPanel>
            </ScrollViewer>
          </DataTemplate>
        </ContentControl.Resources>
      </ContentControl>
    </Border>
  </Grid>
</Page>
